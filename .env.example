# Optional: Celo Sepolia USDC address (decimals 6)
NEXT_PUBLIC_USDC_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E

# Treasury address for the $0.15 service fee per bundle
NEXT_PUBLIC_FEE_RECIPIENT=0x1565c5D9b0C0D9AaaC7ebC9cB0b60eeFd623f819

# Celoscan API key for contract verification (https://celoscan.io/myapikey)
CELOSCAN_API_KEY=WWDSTSHV5N4N8BKD6F8BKTGWEIT6MV21DF