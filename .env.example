# Deployer private key (no 0x prefix) — Hardhat only, never expose
PRIVATE_KEY=

# Network: "mainnet" → Celo 42220, anything else → Celo Sepolia 11142220
NEXT_PUBLIC_NETWORK=testnet

# RPC URLs — public fallbacks are baked into chains.ts; override for dedicated nodes
NEXT_PUBLIC_CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

# Hardhat-only RPC (not exposed to browser)
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_RPC_URL=https://forno.celo.org

# Deployed contract addresses — fill in after: npm run deploy:sepolia
NEXT_PUBLIC_DISPERSE_ADDRESS=
NEXT_PUBLIC_MOCK_USD_ADDRESS=

# Celo Sepolia USDC (decimals 6)
NEXT_PUBLIC_USDC_ADDRESS=0x01C5C0122039549AD1493B8220cABEdD739BC44E

# Treasury address for the $0.15 service fee per bundle
NEXT_PUBLIC_FEE_RECIPIENT=

# Celoscan API key — get free key at https://celoscan.io/myapikey
CELOSCAN_API_KEY=