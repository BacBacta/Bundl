# RPC URLs (public fallbacks are set in hardhat.config.ts)
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_RPC_URL=https://forno.celo.org

# Deployed contract addresses — fill in after running: npm run deploy:sepolia
